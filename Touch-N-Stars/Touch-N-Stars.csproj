<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <UsePinsSource Condition="'$(PinsRoot)' != '' or $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">true</UsePinsSource>
    <PinsRoot Condition="'$(UsePinsSource)' == 'true' and '$(PinsRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..</PinsRoot>
    <OutputType>Library</OutputType>
    <RootNamespace>TouchNStars</RootNamespace>
    <AssemblyName>TouchNStars</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF Condition="'$(UsePinsSource)' != 'true'">true</UseWPF>
    <ImportWindowsDesktopTargets Condition="'$(UsePinsSource)' != 'true'">true</ImportWindowsDesktopTargets>
    <EnableWindowsTargeting Condition="'$(UsePinsSource)' != 'true'">true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Workaround for ToastNotifications localization issue on German systems -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DefaultItemExcludes Condition="'$(UsePinsSource)' == 'true'">$(DefaultItemExcludes);**/*.xaml.cs;**/*.xaml</DefaultItemExcludes>
    <!-- PINS builds against the NINA sources, which are ahead of the 3.1.2 packages used on Windows
         (e.g. ISymbolBroker, sequencer expressions). Shared code checks it with #if PINS. -->
    <DefineConstants Condition="'$(UsePinsSource)' == 'true'">$(DefineConstants);PINS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EmbedIO" Version="3.5.2" />
    <PackageReference Include="HttpMultipartParser" Version="10.0.0" />
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
    <PackageReference Include="Makaretu.Dns.New" Version="3.1.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Condition="'$(UsePinsSource)' != 'true'" Include="NINA.Plugin" Version="3.1.2.9001" />
    <PackageReference Condition="'$(UsePinsSource)' != 'true'" Include="NINA.WPF.Base" Version="3.1.2.9001" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePinsSource)' == 'true'">
    <ProjectReference Include="$(PinsRoot)\NINA.Plugin\NINA.Plugin.csproj" />
    <ProjectReference Include="$(PinsRoot)\System.Windows.Compat\System.Windows.Compat.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="*" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.Settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.Settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Server\Models\indi_drivers\*.json" />
  </ItemGroup>
  <PropertyGroup />
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(UsePinsSource)' != 'true' and '$(SkipPluginDeployment)' != 'true'">
    <PropertyGroup>
      <WindowsPluginDeployDir>$([System.IO.Path]::Combine($([System.Environment]::GetEnvironmentVariable('LOCALAPPDATA')), 'NINA', 'Plugins', '3.0.0', 'Touch ''N'' Stars'))</WindowsPluginDeployDir>
    </PropertyGroup>
    <Message Text="Copying plugin output to $(WindowsPluginDeployDir)" Importance="High" />
    <MakeDir Directories="$(WindowsPluginDeployDir)" />
    <ItemGroup>
      <WindowsPluginDeployFiles Include="$(TargetDir)**\*" Exclude="$(TargetDir)**\*.pdb;$(TargetDir)**\*.xml" />
    </ItemGroup>
    <Copy
      SourceFiles="@(WindowsPluginDeployFiles)"
      DestinationFiles="@(WindowsPluginDeployFiles->'$(WindowsPluginDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PostBuildLinux" AfterTargets="PostBuildEvent" Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux))) and '$(SkipPluginDeployment)' != 'true'">
    <Exec Command="mkdir -p $HOME/.local/share/NINA/Plugins/3.0.0/Touch\ N\ Stars" />
    <Exec Command="cp $(TargetPath) $HOME/.local/share/NINA/Plugins/3.0.0/Touch\ N\ Stars/" />
    <Exec Command="cp $(TargetDir)Common.Logging.dll $HOME/.local/share/NINA/Plugins/3.0.0/Touch\ N\ Stars/" />
    <Exec Command="cp $(TargetDir)Common.Logging.Core.dll $HOME/.local/share/NINA/Plugins/3.0.0/Touch\ N\ Stars/" />
    <Exec Command="cp $(TargetDir)EmbedIO.dll $HOME/.local/share/NINA/Plugins/3.0.0/Touch\ N\ Stars/" />
    <Exec Command="cp $(TargetDir)HttpMultipartParser.dll $HOME/.local/share/NINA/Plugins/3.0.0/Touch\ N\ Stars/" />
    <Exec Command="cp $(TargetDir)Makaretu.Dns.dll $HOME/.local/share/NINA/Plugins/3.0.0/Touch\ N\ Stars/" />
    <Exec Command="cp $(TargetDir)Makaretu.Dns.Multicast.New.dll $HOME/.local/share/NINA/Plugins/3.0.0/Touch\ N\ Stars/" />
    <Exec Command="cp $(TargetDir)SixLabors.ImageSharp.dll $HOME/.local/share/NINA/Plugins/3.0.0/Touch\ N\ Stars/" />
    <Exec Command="cp $(TargetDir)Swan.Lite.dll $HOME/.local/share/NINA/Plugins/3.0.0/Touch\ N\ Stars/" />
  </Target>
</Project>
